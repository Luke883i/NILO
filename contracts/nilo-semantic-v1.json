  "story": {
    "id": "STORY-01",
    "status": "PROPOSED_NOT_AUTHOR_APPROVED",
    "setting": "Ramecittà, a town where the Factory of Hours distributes time to everyone",
    "premise": "The clock apprentice Nilo discovers that six hours have been locked away; reclaiming them requires restoring the factory without taking time from anyone else.",
    "theme": "Time is shared; power over time must be accountable.",
    "conflict": "The Director of Hours hoards the six hours, transforming citizens' routines into rigid schedules.",
    "story_arc": [
      "Curiosity at the factory gate",
      "A clock that runs only for the powerful",
      "Uncovering the cost of stolen minutes",
      "Choosing repairs instead of revenge",
      "Giving citizens control of their time",
      "Restoring the shared clock"
    ],
    "ending": "The factory belongs to its citizens; Nilo learns to repair systems, not to control people.",
    "nonclaims": [
      "No existing published franchise or protected character assets are licensed by this draft.",
      "Creative originality and trademark clearance require human review."
    ]
  },
